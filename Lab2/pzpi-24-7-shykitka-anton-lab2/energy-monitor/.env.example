# PostgreSQL 18
POSTGRES_USER=pguser
POSTGRES_PASSWORD=changeme123!0
POSTGRES_DB=energymon
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433

# Application
ENVIRONMENT=development
PROJECT_NAME="EnergyMonitor"
SECRET_KEY=super-secret-dev-jwt-key-replace-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["https://energymon.localhost","http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=https://energymon.localhost
VITE_API_BASE_URL=https://api.energymon.localhost

# Mail (FastAPI-Mail)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@energymon.com
MAIL_PORT=1026
MAIL_SERVER=localhost
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_FROM_NAME="EnergyMonitor Support"

# LLM Analytics (Optional API key for real LLM provider; falls back to analytical heuristic engine)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Backups directory
BACKUP_DIR=backups

